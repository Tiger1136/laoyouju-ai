# ============================================================
# 劳有据 AI —— 环境变量示例（仅示例，禁止填写真实密钥）
# 复制为 .env 后填写实际值；.env 已被 .gitignore 忽略，禁止提交。
# ============================================================

# DeepSeek API Key —— 只能配置在云函数端（服务端环境变量）。
# 严禁进入网页构建产物、小程序代码、日志、测试快照或 Git。
# 本阶段（Phase 4+5）使用 mock fetch 测试，不配置也可运行；配置后才可调用真实模型。
DEEPSEEK_API_KEY=

# DeepSeek API 地址（默认官方地址；如官方调整请按官方文档更新）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型名（以 DeepSeek 开放平台实际可用模型为准；不使用已弃用的旧模型名作为默认值）
DEEPSEEK_MODEL=deepseek-v4-flash

# CloudBase 环境 ID（云函数端使用；Phase 6 部署时配置）
CLOUDBASE_ENV_ID=

# 腾讯云联网搜索（WSA）“服务 API KEY”密钥 —— 仅服务端环境变量，绝不写入源码/前端/日志/Git/报告。
# 协议唯一依据：https://cloud.tencent.com/document/product/1806/130615
# 未配置时 provider=undefined，本地知识库仍可工作（不发起联网搜索）。本阶段（Phase 7A）测试使用 mock fixture，不配置真实 Key、不调用真实 WSA。
WSA_API_KEY=

# WSA 服务地址（可选，仅测试覆盖；默认官方 https://api.wsa.cloud.tencent.com，路径 /SearchPro）
WSA_API_BASE_URL=

# WSA 超时毫秒（可选，默认 10000）；每次最多结果数（可选，默认 10；请求按官方参数 Cnt 规格化为 10/20/30/40/50）
WSA_TIMEOUT_MS=10000
WSA_MAX_RESULTS=10

# 服务端 CORS 精确 Origin 白名单（逗号分隔；云函数端环境变量）。
# 带 Origin 的浏览器请求只允许白名单来源；未配置时对带 Origin 的请求 fail-closed。
# 也可用 WEB_ALLOWED_ORIGIN 指定（二者取并集，便于与客户端站点对齐）。
ALLOWED_ORIGINS=http://localhost:3000

# Web 允许的 Origin（可选；与 ALLOWED_ORIGINS 取并集）
WEB_ALLOWED_ORIGIN=

# 公开变量：网页端在浏览器代码中读取的 API 基地址（CloudBase 云函数 HTTP 访问路径）。
# 它是公开变量，不是密钥，允许进入前端构建产物；仅为本阶段的地址占位。
# 未配置时 /ask 显示“问答服务尚未配置”，不会白屏。
NEXT_PUBLIC_API_BASE_URL=

# 公开变量：构建期用于网页 SEO metadata（metadataBase / sitemap / robots）。
# 上线时替换为真实域名；它不是密钥，允许进入前端构建产物。
# VPS 同源部署：不需要配置（前端默认使用同源 /api/...）；CloudBase 跨域部署时配置为绝对地址。
# 注意：VPS 阶段不配置域名，勿把公网 IP 硬编码进代码/构建。
NEXT_PUBLIC_SITE_URL=https://example.com
# ============================================================
# Phase 9：腾讯云轻量应用服务器（VPS）部署相关变量
# （仅当以 BUDGET_STORE=sqlite 等单机方式运行时需要；CloudBase 云函数环境不受影响）
# ============================================================

# 预算存储选择：sqlite（VPS 单机）/ cloudbase（旧 CloudBase 环境）
# 缺失或非法 → 真实模型调用安全失败（429 STORE_ERROR），绝不静默降级内存预算。
BUDGET_STORE=sqlite

# SQLite 预算库绝对路径（独立持久化数据目录；不得放发布目录/前端产物/Git）
BUDGET_SQLITE_PATH=/var/lib/laoyouju/budget/budget.sqlite3

# Node API 监听地址：VPS 只允许回环（HOST=127.0.0.1），配合 Nginx 反代；
# CloudBase 环境保持默认 0.0.0.0（不设置本变量即可）。
HOST=127.0.0.1

# 受信任反向代理（逗号分隔）：只有这些对端的 X-Forwarded-For 才被采用（VPS 为本机 Nginx）。
TRUSTED_PROXY=127.0.0.1
