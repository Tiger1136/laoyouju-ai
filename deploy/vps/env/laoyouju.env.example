# ============================================================
# 劳有据 AI —— 服务器环境变量示例（Phase 9）
# 服务器实际文件：/etc/laoyouju/laoyouju.env（权限 0600 root:laoyouju；install.sh 创建）
# 只许在此处填写真实密钥；严禁写入 Git/日志/命令历史/报告/聊天。
# 本文件为无密钥示例；install.sh 仅在文件不存在时复制。
# ============================================================

# ---- 运行时 ----
# Node API 监听地址：VPS 只允许回环（配合 Nginx 反代 + 防火墙，9000 不得暴露公网）
HOST=127.0.0.1
# Node API 端口（回环监听，公网不可达）
PORT=9000

# ---- 预算存储（必须显式选择；缺失或非法 → 真实模型调用安全失败）----
# sqlite（VPS 单机）/ cloudbase（旧 CloudBase 环境）；禁止 memory
BUDGET_STORE=sqlite
# SQLite 文件：独立持久化数据目录（绝对路径；发布目录/前端产物之外；属主 laoyouju）
BUDGET_SQLITE_PATH=/var/lib/laoyouju/budget/budget.sqlite3

# ---- 真实客户端 IP 信任边界 ----
# 只有来自这些对端的 X-Forwarded-For 才被采用（本机 Nginx）
TRUSTED_PROXY=127.0.0.1

# ---- CORS 精确 Origin 白名单（逗号分隔）----
# 浏览器同源 POST 仍携带 Origin；必须填 http://<公网IP>（不带端口；勿加 https）
ALLOWED_ORIGINS=http://<公网IP>
# 格式备注：同一 Origin 若同时存在 http://<IP> 与 http://<IP>:80，浏览器只会发送 http://<IP>
WEB_ALLOWED_ORIGIN=

# ---- DeepSeek（仅服务端；密钥只存在于本文件）----
# Phase 9A：首次公网 IP 部署阶段可以留空（无需填写/传递任何 Key）；
# 无模型验证全部通过后，真实模型测试需项目经理另行授权，届时才填写。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 联网搜索（可选；未配置时本地知识库仍工作，不发起联网调用）----
WSA_API_KEY=
WSA_API_BASE_URL=
WSA_TIMEOUT_MS=10000
WSA_MAX_RESULTS=10

# ---- 限流与费用保护（可选；缺省使用安全默认值）----
LIMIT_CLIENT_PER_MINUTE=6
LIMIT_CLIENT_PER_DAY=30
LIMIT_GLOBAL_MODEL_PER_DAY=100
LIMIT_MAX_CONCURRENT_MODELS=3
# kill switch：off/on（紧急停止真实模型调用）。
# Phase 9A：首次公网 IP 部署阶段默认 = on（真实模型调用被阻断，费用保护最强）；
# 无模型验证全部通过、项目经理另行授权真实模型测试后，才改为 off。
LIMIT_KILL_SWITCH=on

# ---- 内容库根（运行目录为 /opt/laoyouju/current 时可省略；显式列出更稳妥）----
RETRIEVAL_CONTENT_ROOT=/opt/laoyouju/current/content
