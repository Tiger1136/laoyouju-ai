  "provisions": [
    {
      "provisionId": "laodonghetongfa-shishitiaoli-1",
      "locator": "第一条",
      "sourceText": "第一条 为了贯彻实施《中华人民共和国劳动合同法》（以下简称劳动合同法），制定本条例。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "8f9046cc6675a6dffa915e3b2d4b62619052a68dd2fe3d2be1a3ef7c9d16b843"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-2",
      "locator": "第二条",
      "sourceText": "第二条 各级人民政府和县级以上人民政府劳动行政等有关部门以及工会等组织，应当采取措施，推动劳动合同法的贯彻实施，促进劳动关系的和谐。",
      "topicIds": [
        "contract-performance",
        "labor-relationship-recognition"
      ],
      "keywords": [],
      "textSha256": "fced3443249e4e5c24410e450c2daf10dad47997def550b30c62918610098159"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-3",
      "locator": "第三条",
      "sourceText": "第三条 依法成立的会计师事务所、律师事务所等合伙组织和基金会，属于劳动合同法规定的用人单位。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "928f983af484a52167b0b5222c1596752aec5167065e1c4c7651937aa215a128"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-4",
      "locator": "第四条",
      "sourceText": "第四条 劳动合同法规定的用人单位设立的分支机构，依法取得营业执照或者登记证书的，可以作为用人单位与劳动者订立劳动合同；未依法取得营业执照或者登记证书的，受用人单位委托可以与劳动者订立劳动合同。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "c90252a3604cb1476b3c55636fcba9937e0de0152394718563e3a659def1fc1d"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-5",
      "locator": "第五条",
      "sourceText": "第五条 自用工之日起一个月内，经用人单位书面通知后，劳动者不与用人单位订立书面劳动合同的，用人单位应当书面通知劳动者终止劳动关系，无需向劳动者支付经济补偿，但是应当依法向劳动者支付其实际工作时间的劳动报酬。",
      "topicIds": [
        "working-hours-leave",
        "wage-arrears",
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "no-written-contract",
        "contract-performance",
        "labor-relationship-recognition"
      ],
      "keywords": [],
      "textSha256": "05501d32e7d7ba3a89f50833bf9d1d1d2dce97606e48e76324a74184547313c5"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-6",
      "locator": "第六条",
      "sourceText": "第六条 用人单位自用工之日起超过一个月不满一年未与劳动者订立书面劳动合同的，应当依照劳动合同法第八十二条的规定向劳动者每月支付两倍的工资，并与劳动者补订书面劳动合同；劳动者不与用人单位订立书面劳动合同的，用人单位应当书面通知劳动者终止劳动关系，并依照劳动合同法第四十七条的规定支付经济补偿。 前款规定的用人单位向劳动者每月支付两倍工资的起算时间为用工之日起满一个月的次日，截止时间为补订书面劳动合同的前一日。",
      "topicIds": [
        "wage-arrears",
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "double-wage-notice",
        "no-written-contract",
        "contract-performance",
        "labor-relationship-recognition",
        "arbitration-limitation"
      ],
      "keywords": [],
      "textSha256": "af3bf3d1df7b759efda5d571f622300fd2072b509e3b384dfec23e0b77c3adbf"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-7",
      "locator": "第七条",
      "sourceText": "第七条 用人单位自用工之日起满一年未与劳动者订立书面劳动合同的，自用工之日起满一个月的次日至满一年的前一日应当依照劳动合同法第八十二条的规定向劳动者每月支付两倍的工资，并视为自用工之日起满一年的当日已经与劳动者订立无固定期限劳动合同，应当立即与劳动者补订书面劳动合同。",
      "topicIds": [
        "wage-arrears",
        "no-written-contract",
        "contract-performance",
        "arbitration-limitation"
      ],
      "keywords": [],
      "textSha256": "9619f580452a1eb7ff6c15c3f6115d692b341bede6864dcd92eacf9f661c5f2a"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-8",
      "locator": "第八条",
      "sourceText": "第八条 劳动合同法第七条规定的职工名册，应当包括劳动者姓名、性别、公民身份号码、户籍地址及现住址、联系方式、用工形式、用工起始时间、劳动合同期限等内容。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "d5c61ce164530a7fdf41923acc0653eda676e174ab2d7ff965c0426984bc8dab"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-9",
      "locator": "第九条",
      "sourceText": "第九条 劳动合同法第十四条第二款规定的连续工作满10年的起始时间，应当自用人单位用工之日起计算，包括劳动合同法施行前的工作年限。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "d7db61d5316b0a90c3a917a58489bd195012d53157a8f0f7db4b4802bdbe9d2e"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-10",
      "locator": "第十条",
      "sourceText": "第十条 劳动者非因本人原因从原用人单位被安排到新用人单位工作的，劳动者在原用人单位的工作年限合并计算为新用人单位的工作年限。原用人单位已经向劳动者支付经济补偿的，新用人单位在依法解除、终止劳动合同计算支付经济补偿的工作年限时，不再计算劳动者在原用人单位的工作年限。",
      "topicIds": [
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "ce5b263f386660fceea44b3e2f0a0fd2ca86dcbaa1908ae063a830f7b9c2e601"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-11",
      "locator": "第十一条",
      "sourceText": "第十一条 除劳动者与用人单位协商一致的情形外，劳动者依照劳动合同法第十四条第二款的规定，提出订立无固定期限劳动合同的，用人单位应当与其订立无固定期限劳动合同。对劳动合同的内容，双方应当按照合法、公平、平等自愿、协商一致、诚实信用的原则协商确定；对协商不一致的内容，依照劳动合同法第十八条的规定执行。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "593dd64c78f2e55d0d18eb7754bf87f7417c54fc0a815ebbe17b31657074a62f"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-12",
      "locator": "第十二条",
      "sourceText": "第十二条 地方各级人民政府及县级以上地方人民政府有关部门为安置就业困难人员提供的给予岗位补贴和社会保险补贴的公益性岗位，其劳动合同不适用劳动合同法有关无固定期限劳动合同的规定以及支付经济补偿的规定。",
      "topicIds": [
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance",
        "social-insurance"
      ],
      "keywords": [],
      "textSha256": "7a4a3eb9ee8465c5a68d2a4e1bd3518e83f1160aa397a7e91e60ccae6074c15a"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-13",
      "locator": "第十三条",
      "sourceText": "第十三条 用人单位与劳动者不得在劳动合同法第四十四条规定的劳动合同终止情形之外约定其他的劳动合同终止条件。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "6146009341d1dc1e4f74e6bf9c8d0c6218196ca83cc2dfdee2e3af1dcf76e47e"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-14",
      "locator": "第十四条",
      "sourceText": "第十四条 劳动合同履行地与用人单位注册地不一致的，有关劳动者的最低工资标准、劳动保护、劳动条件、职业危害防护和本地区上年度职工月平均工资标准等事项，按照劳动合同履行地的有关规定执行；用人单位注册地的有关标准高于劳动合同履行地的有关标准，且用人单位与劳动者约定按照用人单位注册地的有关规定执行的，从其约定。",
      "topicIds": [
        "wage-arrears",
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "a93227bbe104aa8719eeb7e2b23904effa9958513f9f2b85ab8cf9c67d369338"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-15",
      "locator": "第十五条",
      "sourceText": "第十五条 劳动者在试用期的工资不得低于本单位相同岗位最低档工资的80%或者不得低于劳动合同约定工资的80%，并不得低于用人单位所在地的最低工资标准。",
      "topicIds": [
        "wage-arrears",
        "contract-performance",
        "probation-disputes"
      ],
      "keywords": [],
      "textSha256": "28405a5f33fd3dc7b981ece4fc464f8d29b50b0cdcd34086eee3b71cb077eb91"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-16",
      "locator": "第十六条",
      "sourceText": "第十六条 劳动合同法第二十二条第二款规定的培训费用，包括用人单位为了对劳动者进行专业技术培训而支付的有凭证的培训费用、培训期间的差旅费用以及因培训产生的用于该劳动者的其他直接费用。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "b91d701a2064ecc69d8652764476d6b1da40d2efa27b9c186b42fc779efeb31d"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-17",
      "locator": "第十七条",
      "sourceText": "第十七条 劳动合同期满，但是用人单位与劳动者依照劳动合同法第二十二条的规定约定的服务期尚未到期的，劳动合同应当续延至服务期满；双方另有约定的，从其约定。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "b4cd0b18545677b8cf73d4d1cf9074df0060e99cfc5ece0ab01a4261eaf40598"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-18",
      "locator": "第十八条",
      "sourceText": "第十八条 有下列情形之一的，依照劳动合同法规定的条件、程序，劳动者可以与用人单位解除固定期限劳动合同、无固定期限劳动合同或者以完成一定工作任务为期限的劳动合同： （一）劳动者与用人单位协商一致的； （二）劳动者提前30日以书面形式通知用人单位的； （三）劳动者在试用期内提前3日通知用人单位的； （四）用人单位未按照劳动合同约定提供劳动保护或者劳动条件的； （五）用人单位未及时足额支付劳动报酬的； （六）用人单位未依法为劳动者缴纳社会保险费的； （七）用人单位的规章制度违反法律、法规的规定，损害劳动者权益的； （八）用人单位以欺诈、胁迫的手段或者乘人之危，使劳动者在违背真实意思的情况下订立或者变更劳动合同的； （九）用人单位在劳动合同中免除自己的法定责任、排除劳动者权利的； （十）用人单位违反法律、行政法规强制性规定的； （十一）用人单位以暴力、威胁或者非法限制人身自由的手段强迫劳动者劳动的； （十二）用人单位违章指挥、强令冒险作业危及劳动者人身安全的； （十三）法律、行政法规规定劳动者可以解除劳动合同的其他情形。",
      "topicIds": [
        "wage-arrears",
        "unlawful-termination-compensation",
        "contract-performance",
        "probation-disputes",
        "social-insurance"
      ],
      "keywords": [],
      "textSha256": "134743872293ff1d1fc3a3aef8cd85b16792c0c013d5981fe1a170734d1661c6"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-19",
      "locator": "第十九条",
      "sourceText": "第十九条 有下列情形之一的，依照劳动合同法规定的条件、程序，用人单位可以与劳动者解除固定期限劳动合同、无固定期限劳动合同或者以完成一定工作任务为期限的劳动合同： （一）用人单位与劳动者协商一致的； （二）劳动者在试用期间被证明不符合录用条件的； （三）劳动者严重违反用人单位的规章制度的； （四）劳动者严重失职，营私舞弊，给用人单位造成重大损害的； （五）劳动者同时与其他用人单位建立劳动关系，对完成本单位的工作任务造成严重影响，或者经用人单位提出，拒不改正的； （六）劳动者以欺诈、胁迫的手段或者乘人之危，使用人单位在违背真实意思的情况下订立或者变更劳动合同的； （七）劳动者被依法追究刑事责任的； （八）劳动者患病或者非因工负伤，在规定的医疗期满后不能从事原工作，也不能从事由用人单位另行安排的工作的； （九）劳动者不能胜任工作，经过培训或者调整工作岗位，仍不能胜任工作的； （十）劳动合同订立时所依据的客观情况发生重大变化，致使劳动合同无法履行，经用人单位与劳动者协商，未能就变更劳动合同内容达成协议的； （十一）用人单位依照企业破产法规定进行重整的； （十二）用人单位生产经营发生严重困难的； （十三）企业转产、重大技术革新或者经营方式调整，经变更劳动合同后，仍需裁减人员的； （十四）其他因劳动合同订立时所依据的客观经济情况发生重大变化，致使劳动合同无法履行的。",
      "topicIds": [
        "contract-performance",
        "probation-disputes",
        "labor-relationship-recognition"
      ],
      "keywords": [],
      "textSha256": "eb0a80168b6b378196421f959a5fea0f3015d8b624c64aacc70493061d7f7fa1"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-20",
      "locator": "第二十条",
      "sourceText": "第二十条 用人单位依照劳动合同法第四十条的规定，选择额外支付劳动者一个月工资解除劳动合同的，其额外支付的工资应当按照该劳动者上一个月的工资标准确定。",
      "topicIds": [
        "wage-arrears",
        "unlawful-termination-compensation",
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "1e3d92b326240545484801e372a9112cf259979100407190ec248c8c9db3fbc5"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-21",
      "locator": "第二十一条",
      "sourceText": "第二十一条 劳动者达到法定退休年龄的，劳动合同终止。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "f0bb7d677f51d7c238de06c973a23340e08829dd89982ae29d53f80a969c2761"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-22",
      "locator": "第二十二条",
      "sourceText": "第二十二条 以完成一定工作任务为期限的劳动合同因任务完成而终止的，用人单位应当依照劳动合同法第四十七条的规定向劳动者支付经济补偿。",
      "topicIds": [
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "ef423ab4db8dabb40b0dab675d8f6aa0085d49f5d9f5514b4fed3b6a1b78a754"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-23",
      "locator": "第二十三条",
      "sourceText": "第二十三条 用人单位依法终止工伤职工的劳动合同的，除依照劳动合同法第四十七条的规定支付经济补偿外，还应当依照国家有关工伤保险的规定支付一次性工伤医疗补助金和伤残就业补助金。",
      "topicIds": [
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance",
        "social-insurance",
        "work-injury"
      ],
      "keywords": [],
      "textSha256": "d29646b21abd7cbf578c170f925cfdc6b1a64120e8bceede3d7a6b0755a8b8f2"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-24",
      "locator": "第二十四条",
      "sourceText": "第二十四条 用人单位出具的解除、终止劳动合同的证明，应当写明劳动合同期限、解除或者终止劳动合同的日期、工作岗位、在本单位的工作年限。",
      "topicIds": [
        "unlawful-termination-compensation",
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "ac336a540572b060b80645914664eef45d6ee2cd5b547b4509e1cc58f58c89b7"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-25",
      "locator": "第二十五条",
      "sourceText": "第二十五条 用人单位违反劳动合同法的规定解除或者终止劳动合同，依照劳动合同法第八十七条的规定支付了赔偿金的，不再支付经济补偿。赔偿金的计算年限自用工之日起计算。",
      "topicIds": [
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance"
      ],
      "keywords": [
        "赔偿金",
        "经济补偿",
        "违法解除"
      ],
      "textSha256": "49c13d9f3096ba8589671b94da138366afa688bdb9a1315e3e8d974980f4d13e"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-26",
      "locator": "第二十六条",
      "sourceText": "第二十六条 用人单位与劳动者约定了服务期，劳动者依照劳动合同法第三十八条的规定解除劳动合同的，不属于违反服务期的约定，用人单位不得要求劳动者支付违约金。 有下列情形之一，用人单位与劳动者解除约定服务期的劳动合同的，劳动者应当按照劳动合同的约定向用人单位支付违约金： （一）劳动者严重违反用人单位的规章制度的； （二）劳动者严重失职，营私舞弊，给用人单位造成重大损害的； （三）劳动者同时与其他用人单位建立劳动关系，对完成本单位的工作任务造成严重影响，或者经用人单位提出，拒不改正的； （四）劳动者以欺诈、胁迫的手段或者乘人之危，使用人单位在违背真实意思的情况下订立或者变更劳动合同的； （五）劳动者被依法追究刑事责任的。",
      "topicIds": [
        "unlawful-termination-compensation",
        "contract-performance",
        "labor-relationship-recognition"
      ],
      "keywords": [],
      "textSha256": "52a1c7465b882264a4d0e2dda14aecedbc8a3aad56e10bffa2f91e232992391f"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-27",
      "locator": "第二十七条",
      "sourceText": "第二十七条 劳动合同法第四十七条规定的经济补偿的月工资按照劳动者应得工资计算，包括计时工资或者计件工资以及奖金、津贴和补贴等货币性收入。劳动者在劳动合同解除或者终止前12个月的平均工资低于当地最低工资标准的，按照当地最低工资标准计算。劳动者工作不满12个月的，按照实际工作的月数计算平均工资。",
      "topicIds": [
        "wage-arrears",
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "eec3cf1656e5ed49c1e49571bc567f2dee13ebb58257834e6346954d50aba09f"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-28",
      "locator": "第二十八条",
      "sourceText": "第二十八条 用人单位或者其所属单位出资或者合伙设立的劳务派遣单位，向本单位或者所属单位派遣劳动者的，属于劳动合同法第六十七条规定的不得设立的劳务派遣单位。",
      "topicIds": [
        "contract-performance",
        "labor-dispatch"
      ],
      "keywords": [],
      "textSha256": "65cee91bcf66ede72b2f94333a2fde7b46b05c40d3cf3add6436724ebada4352"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-29",
      "locator": "第二十九条",
      "sourceText": "第二十九条 用工单位应当履行劳动合同法第六十二条规定的义务，维护被派遣劳动者的合法权益。",
      "topicIds": [
        "contract-performance",
        "labor-dispatch"
      ],
      "keywords": [],
      "textSha256": "fab350fea2b40ed0283f66c182db09e03e6b6f1f9157cfe172aeac7af1302ed2"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-30",
      "locator": "第三十条",
      "sourceText": "第三十条 劳务派遣单位不得以非全日制用工形式招用被派遣劳动者。",
      "topicIds": [
        "labor-dispatch"
      ],
      "keywords": [],
      "textSha256": "9476d5b7013477da98484b4a222ad453c090e1814710d15682d7d60da92170c9"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-31",
      "locator": "第三十一条",
      "sourceText": "第三十一条 劳务派遣单位或者被派遣劳动者依法解除、终止劳动合同的经济补偿，依照劳动合同法第四十六条、第四十七条的规定执行。",
      "topicIds": [
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance",
        "labor-dispatch"
      ],
      "keywords": [],
      "textSha256": "d047577d68b0d8fc0c0db779949f75584618dd27286c355f2deecac4346b7ee3"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-32",
      "locator": "第三十二条",
      "sourceText": "第三十二条 劳务派遣单位违法解除或者终止被派遣劳动者的劳动合同的，依照劳动合同法第四十八条的规定执行。",
      "topicIds": [
        "unlawful-termination-compensation",
        "contract-performance",
        "labor-dispatch"
      ],
      "keywords": [],
      "textSha256": "8f2532c04594c7244b292d3241b1b3a586ed56a051b1b60a4b95b8bc2c05a3bc"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-33",
      "locator": "第三十三条",
      "sourceText": "第三十三条 用人单位违反劳动合同法有关建立职工名册规定的，由劳动行政部门责令限期改正；逾期不改正的，由劳动行政部门处2000元以上2万元以下的罚款。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "b25544fe596f3729190b9061f37b7c94571e388d3496258b4291cd6e8e843581"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-34",
      "locator": "第三十四条",
      "sourceText": "第三十四条 用人单位依照劳动合同法的规定应当向劳动者每月支付两倍的工资或者应当向劳动者支付赔偿金而未支付的，劳动行政部门应当责令用人单位支付。",
      "topicIds": [
        "wage-arrears",
        "unlawful-termination-compensation",
        "compensation-and-damages",
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "c6f58a3d14525b9689ad95a1300b2a1a696147e050f7a725ab042c25285c36fb"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-35",
      "locator": "第三十五条",
      "sourceText": "第三十五条 用工单位违反劳动合同法和本条例有关劳务派遣规定的，由劳动行政部门和其他有关主管部门责令改正；情节严重的，以每位被派遣劳动者1000元以上5000元以下的标准处以罚款；给被派遣劳动者造成损害的，劳务派遣单位和用工单位承担连带赔偿责任。",
      "topicIds": [
        "contract-performance",
        "labor-dispatch"
      ],
      "keywords": [],
      "textSha256": "f3c63c78f399f677a021c162e7a43ba0132608952cf1b20e26020eaf4bb60756"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-36",
      "locator": "第三十六条",
      "sourceText": "第三十六条 对违反劳动合同法和本条例的行为的投诉、举报，县级以上地方人民政府劳动行政部门依照《劳动保障监察条例》的规定处理。",
      "topicIds": [
        "contract-performance"
      ],
      "keywords": [],
      "textSha256": "55fa73ab4697eb8f069a1490c51fa889a88bf71edd2d58039d7f5b4c92d0dae6"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-37",
      "locator": "第三十七条",
      "sourceText": "第三十七条 劳动者与用人单位因订立、履行、变更、解除或者终止劳动合同发生争议的，依照《中华人民共和国劳动争议调解仲裁法》的规定处理。",
      "topicIds": [
        "unlawful-termination-compensation",
        "contract-performance",
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "3b7f5fdfccaa7bea157875ec6199b2af2ef22ab253f6384f5a5519fd2ba7ff80"
    },
    {
      "provisionId": "laodonghetongfa-shishitiaoli-38",
      "locator": "第三十八条",
      "sourceText": "第三十八条 本条例自公布之日起施行。",
      "topicIds": [],
      "keywords": [],
      "textSha256": "0acd8ba1f3282ecca4410b1897b6ea7c7139fdec5c2b82df32cdefb84b1335ce"
    }
  ],
