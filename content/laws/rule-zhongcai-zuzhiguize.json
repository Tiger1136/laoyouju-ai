    "noncompete-confidentiality"
  ],
  "provisions": [
    {
      "provisionId": "zhongcai-zuzhiguize-1",
      "locator": "第一条",
      "sourceText": "第一条 为公正及时处理劳动人事争议（以下简称争议），根据《中华人民共和国劳动争议调解仲裁法》（以下简称调解仲裁法）和《中华人民共和国公务员法》、《事业单位人事管理条例》、《中国人民解放军文职人员条例》等有关法律、法规，制定本规则。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "6d951ba4cd7402d411443a1ffbab1c861645a707d0690c910989822e32bea326"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-2",
      "locator": "第二条",
      "sourceText": "第二条 劳动人事争议仲裁委员会（以下简称仲裁委员会）由人民政府依法设立，专门处理争议案件。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "95ba79563d7a02174bdbb99d908221a3efe27d6f266889722a54cfcb9ecaa481"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-3",
      "locator": "第三条",
      "sourceText": "第三条 人力资源社会保障行政部门负责指导本行政区域的争议调解仲裁工作，组织协调处理跨地区、有影响的重大争议，负责仲裁员的管理、培训等工作。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "5a6cc26c09967e700fd800ceb480d2d327066c2ce54d2833d88a8315a1bbb2a7"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-4",
      "locator": "第四条",
      "sourceText": "第四条 仲裁委员会按照统筹规划、合理布局和适应实际需要的原则设立，由省、自治区、直辖市人民政府依法决定。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "be376d502033efdd1bfe59fd4cf20b20b5959dfe8ae8df515c08d71b88a4bc68"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-5",
      "locator": "第五条",
      "sourceText": "第五条 仲裁委员会由干部主管部门代表、人力资源社会保障等相关行政部门代表、军队文职人员工作管理部门代表、工会代表和用人单位方面代表等组成。 仲裁委员会组成人员应当是单数。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "90d4a3d2f4476f3921120ca101eae7683400c5163a95c1c3f86f9f3cbcb51b00"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-6",
      "locator": "第六条",
      "sourceText": "第六条 仲裁委员会设主任一名，副主任和委员若干名。 仲裁委员会主任由政府负责人或者人力资源社会保障行政部门主要负责人担任。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "a4269b3b895b6baeb688c2f14876765314db856f1ccc14cfce1c4fcf4b4bf985"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-7",
      "locator": "第七条",
      "sourceText": "第七条 仲裁委员会依法履行下列职责： （一）聘任、解聘专职或者兼职仲裁员； （二）受理争议案件； （三）讨论重大或者疑难的争议案件； （四）监督本仲裁委员会的仲裁活动； （五）制定本仲裁委员会的工作规则； （六）其他依法应当履行的职责。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "5c661958d19da3f0887c20924cb55cf27502f97c559fd5c3261ced5cb5c7105a"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-8",
      "locator": "第八条",
      "sourceText": "第八条 仲裁委员会应当每年至少召开两次全体会议，研究本仲裁委员会职责履行情况和重要工作事项。 仲裁委员会主任或者三分之一以上的仲裁委员会组成人员提议召开仲裁委员会会议的，应当召开。 仲裁委员会的决定实行少数服从多数原则。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "94d4ff5bf57b0bfa15498bb5c4f77443862c0a61ef831128223fb4a4b4e746de"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-9",
      "locator": "第九条",
      "sourceText": "第九条 仲裁委员会下设实体化的办事机构，具体承担争议调解仲裁等日常工作。办事机构称为劳动人事争议仲裁院（以下简称仲裁院），设在人力资源社会保障行政部门。 仲裁院对仲裁委员会负责并报告工作。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "24514dcdf3c170377e98a2fcdba905f691834682deee9909421a807075d06e3a"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-10",
      "locator": "第十条",
      "sourceText": "第十条 仲裁委员会的经费依法由财政予以保障。仲裁经费包括人员经费、公用经费、仲裁专项经费等。 仲裁院可以通过政府购买服务等方式聘用记录人员、安保人员等办案辅助人员。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "2f1dfa562af35ac11251c53b9a71f7a1af254edfbdae725099fbc285203e8590"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-11",
      "locator": "第十一条",
      "sourceText": "第十一条 仲裁委员会组成单位可以派兼职仲裁员常驻仲裁院，参与争议调解仲裁活动。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "1aa02016300dd4893451a052da563db46b7b1031bb2a2e34c0e98156b68ef072"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-12",
      "locator": "第十二条",
      "sourceText": "第十二条 仲裁委员会处理争议案件实行仲裁庭制度，实行一案一庭制。 仲裁委员会可以根据案件处理实际需要设立派驻仲裁庭、巡回仲裁庭、流动仲裁庭，就近就地处理争议案件。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "e717205b35bcaaf3675a548b5db1dc3793bdb9299b7a7bdcba807b56049ccf4f"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-13",
      "locator": "第十三条",
      "sourceText": "第十三条 处理下列争议案件应当由三名仲裁员组成仲裁庭，设首席仲裁员： （一）十人以上并有共同请求的争议案件； （二）履行集体合同发生的争议案件； （三）有重大影响或者疑难复杂的争议案件； （四）仲裁委员会认为应当由三名仲裁员组庭处理的其他争议案件。 简单争议案件可以由一名仲裁员独任仲裁。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "da07296c27642967b37097f2febb412f56475e7be3d226c6d09f97bc3500fa4e"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-14",
      "locator": "第十四条",
      "sourceText": "第十四条 记录人员负责案件庭审记录等相关工作。 记录人员不得由本庭仲裁员兼任。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "5aa4f8547e0ab33a3f6ab873b749ec6b5d99aad194b58a83f9b796d9a583e7cc"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-15",
      "locator": "第十五条",
      "sourceText": "第十五条 仲裁庭组成不符合规定的，仲裁委员会应当予以撤销并重新组庭。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "fb55b9a4d76182f2a6cd62ade6d59d1b3cfa818d80cc2f255ecfa591529287b5"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-16",
      "locator": "第十六条",
      "sourceText": "第十六条 仲裁委员会应当有专门的仲裁场所。仲裁场所应当悬挂仲裁徽章，张贴仲裁庭纪律及注意事项等，并配备仲裁庭专业设备、档案储存设备、安全监控设备和安检设施等。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "4f9cc0a22c490c00540ed5416b6847beac49cd1b6434c78d64465e95d6e90e04"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-17",
      "locator": "第十七条",
      "sourceText": "第十七条 仲裁工作人员在仲裁活动中应当统一着装，佩戴仲裁徽章。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "abfe0efe20ac8a03d7b50ce54446a0aa99beba8e6dda5adce7d4bdcbddadfdbc"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-18",
      "locator": "第十八条",
      "sourceText": "第十八条 仲裁员是由仲裁委员会聘任、依法调解和仲裁争议案件的专业工作人员。 仲裁员分为专职仲裁员和兼职仲裁员。专职仲裁员和兼职仲裁员在调解仲裁活动中享有同等权利，履行同等义务。 兼职仲裁员进行仲裁活动，所在单位应当予以支持。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "7a644ca4378aa4cef212a4e1b4184aa9cb8a8aa5b2b4bdc3db500bd122e317a7"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-19",
      "locator": "第十九条",
      "sourceText": "第十九条 仲裁委员会应当依法聘任一定数量的专职仲裁员，也可以根据办案工作需要，依法从干部主管部门、人力资源社会保障行政部门、军队文职人员工作管理部门、工会、企业组织等相关机构的人员以及专家学者、律师中聘任兼职仲裁员。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "4b14c2493531200f4c1c487ef1f3a743919227b9485525ed2a1b2e5f8559b9e3"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-20",
      "locator": "第二十条",
      "sourceText": "第二十条 仲裁员享有以下权利： （一）履行职责应当具有的职权和工作条件； （二）处理争议案件不受干涉； （三）人身、财产安全受到保护； （四）参加聘前培训和在职培训； （五）法律、法规规定的其他权利。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "7bfe18e5e0e5d091585142ad670e49148bd979b015a694d4bed0d079ef29f66f"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-21",
      "locator": "第二十一条",
      "sourceText": "第二十一条 仲裁员应当履行以下义务： （一）依法处理争议案件； （二）维护国家利益和公共利益，保护当事人合法权益； （三）严格执行廉政规定，恪守职业道德； （四）自觉接受监督； （五）法律、法规规定的其他义务。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "f75887d5c9b17b5dffc6ed8998d69a1bdd570097b1b79f6f2d5e0ec4625b0121"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-22",
      "locator": "第二十二条",
      "sourceText": "第二十二条 仲裁委员会聘任仲裁员时，应当从符合调解仲裁法第二十条规定的仲裁员条件的人员中选聘。 仲裁委员会应当根据工作需要，合理配备专职仲裁员和办案辅助人员。专职仲裁员数量不得少于三名，办案辅助人员不得少于一名。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "e4322ce69b9546e7c9fabf1bda30a53d8fa9c1f05c01ec3249da58f5d070e773"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-23",
      "locator": "第二十三条",
      "sourceText": "第二十三条 仲裁委员会应当设仲裁员名册，并予以公告。 省、自治区、直辖市人力资源社会保障行政部门应当将本行政区域内仲裁委员会聘任的仲裁员名单报送人力资源社会保障部备案。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "1a2da59ebd6a1780d20d9b975800cd40f334dfdc0ffa810805d1c266aafaf01c"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-24",
      "locator": "第二十四条",
      "sourceText": "第二十四条 仲裁员聘期一般为五年。仲裁委员会负责仲裁员考核，考核结果作为解聘和续聘仲裁员的依据。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "55fbd7a0ccc516753c84e19da28e001a7db51cf2cb0388c400ac5c291b5246be"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-25",
      "locator": "第二十五条",
      "sourceText": "第二十五条 仲裁委员会应当制定仲裁员工作绩效考核标准，重点考核办案质量和效率、工作作风、遵纪守法情况等。考核结果分为优秀、合格、不合格。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "f14efb1097bf109c25db3541d53ef33a4b61d14ab1364bcef3906620e4e36141"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-26",
      "locator": "第二十六条",
      "sourceText": "第二十六条 仲裁员有下列情形之一的，仲裁委员会应当予以解聘： （一）聘期届满不再续聘的； （二）在聘期内因工作岗位变动或者其他原因不再履行仲裁员职责的； （三）年度考核不合格的； （四）因违纪、违法犯罪不能继续履行仲裁员职责的； （五）其他应当解聘的情形。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "567a7eb8484be4d6fdea66253940b1874d1184a41baf14e5e375eebbe2bde066"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-27",
      "locator": "第二十七条",
      "sourceText": "第二十七条 人力资源社会保障行政部门负责对拟聘任的仲裁员进行聘前培训。 拟聘为省、自治区、直辖市仲裁委员会仲裁员及副省级市仲裁委员会仲裁员的，参加人力资源社会保障部组织的聘前培训；拟聘为地（市）、县（区）仲裁委员会仲裁员的，参加省、自治区、直辖市人力资源社会保障行政部门组织的仲裁员聘前培训。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "2c65eaf2afefcb5251996bb282d0b547656c5ce37cc9cd90a80b88e58c38b2c1"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-28",
      "locator": "第二十八条",
      "sourceText": "第二十八条 人力资源社会保障行政部门负责每年对本行政区域内的仲裁员进行政治思想、职业道德、业务能力和作风建设培训。 仲裁员每年脱产培训的时间累计不少于四十学时。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "a472c956e801130a260f10374fba70178baea63c94c866ef1147e3ee1d15387d"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-29",
      "locator": "第二十九条",
      "sourceText": "第二十九条 仲裁委员会应当加强仲裁员作风建设，培育和弘扬具有行业特色的仲裁文化。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "074fd329cc3bb735fc58a888f7b2f2a67b97b49610c7c16ff0086734214b50a8"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-30",
      "locator": "第三十条",
      "sourceText": "第三十条 人力资源社会保障部负责组织制定仲裁员培训大纲，开发培训教材，建立师资库和考试题库。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "5f76c9364d79930049000e22240ba382b320efe497d6b44e822fe8132557884b"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-31",
      "locator": "第三十一条",
      "sourceText": "第三十一条 建立仲裁员职业保障机制，拓展仲裁员职业发展空间。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "6eb795d89988a3df835501b834d02a5289aeb6131be0c26e724725aac3025074"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-32",
      "locator": "第三十二条",
      "sourceText": "第三十二条 仲裁委员会应当建立仲裁监督制度，对申请受理、办案程序、处理结果、仲裁工作人员行为等进行监督。",
      "topicIds": [
        "arbitration-procedure"
      ],
      "keywords": [],
      "textSha256": "847ee614d99cddd31e683e9c5a35ac722ce09bab519edba50e2998812cc7aacb"
    },
    {
      "provisionId": "zhongcai-zuzhiguize-33",
      "locator": "第三十三条",
      "sourceText": "第三十三条 仲裁员不得有下列行为： （一）徇私枉法，偏袒一方当事人； （二）滥用职权，侵犯当事人合法权益； （三）利用职权为自己 或者他人谋取私利 ； （四）隐瞒证据或者伪造证据； （五）私自会见当事人及其代理人，接受当事人及其代理人的请客送礼； （六）故意拖延办案、玩忽职守； （七）泄露案件涉及的国家秘密、商业秘密和个人隐私或者擅自透露案件处理情况； （八）在受聘期间担任所在仲裁委员会受理案件的代理人； （九）其他违法违纪的行为。",
