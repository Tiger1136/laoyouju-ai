  "title": "中华人民共和国劳动争议调解仲裁法",
  "sourceType": "law",
  "issuingAuthority": "全国人民代表大会常务委员会",
  "documentNumber": "中华人民共和国主席令第八十号",
  "promulgationDate": "2007-12-29",
